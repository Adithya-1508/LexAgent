{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lexagent.local/schemas/phase-5.2/legal_provision.schema.json",
  "title": "LegalProvision (Phase 5.2 Effective-Date Versioned)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provision_id",
    "document_id",
    "source_id",
    "jurisdiction",
    "legal_domain",
    "article",
    "language",
    "is_authoritative",
    "text",
    "source_url"
  ],
  "properties": {
    "provision_id": {
      "type": "string",
      "minLength": 1
    },
    "logical_provision_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "version_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "enum": [
        "uae_onshore",
        "difc",
        "adgm",
        "other_free_zone",
        "unknown"
      ]
    },
    "legal_domain": {
      "type": "string",
      "minLength": 1
    },
    "article": {
      "type": "string",
      "minLength": 1
    },
    "clause": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "subclause": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "language": {
      "type": "string",
      "enum": [
        "ar",
        "en"
      ]
    },
    "is_authoritative": {
      "type": "boolean"
    },
    "alignment_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "translation_of": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "translation_provenance": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "authoritative_original",
        "official_government_translation",
        "unavailable_official",
        null
      ],
      "default": null
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "normalized_text": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "default": null
    },
    "effective_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "default": null
    },
    "uncertainty_window_start": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "default": null
    },
    "uncertainty_window_end": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "default": null
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "in_force",
        "superseded",
        "repealed",
        "enacted_pending_commencement",
        "effective_date_unresolved",
        "suspended_gap"
      ],
      "default": "in_force"
    },
    "gap_or_repeal_reason": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "publication_state": {
      "type": "string",
      "enum": [
        "VERIFIED_PUBLISHABLE",
        "PUBLISHED_WITH_CAVEAT",
        "LEGACY_UNVERIFIED",
        "UNRESOLVED_HISTORICAL",
        "BLOCKED_LEGAL_TOPIC"
      ],
      "default": "LEGACY_UNVERIFIED"
    },
    "caveat_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "page_start": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "default": null
    },
    "page_end": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "default": null
    },
    "extraction_fidelity_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0.0,
      "maximum": 1.0,
      "default": null
    },
    "cmap_corruption_detected": {
      "type": "boolean",
      "default": false
    },
    "human_verification_status": {
      "type": "string",
      "enum": [
        "unreviewed",
        "extraction_verified",
        "rejected"
      ],
      "default": "unreviewed"
    },
    "reviewer_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "reviewed_at_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "default": null
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "is_authoritative": {
            "const": true
          }
        },
        "required": [
          "is_authoritative"
        ]
      },
      "then": {
        "properties": {
          "language": {
            "const": "ar"
          },
          "translation_provenance": {
            "const": "authoritative_original"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "in_force"
          }
        },
        "not": {
          "properties": {
            "publication_state": {
              "const": "LEGACY_UNVERIFIED"
            }
          }
        }
      },
      "then": {
        "required": [
          "effective_from"
        ],
        "properties": {
          "effective_from": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "const": "superseded"
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "required": [
          "effective_from",
          "effective_until"
        ],
        "properties": {
          "effective_from": {
            "type": "string",
            "format": "date"
          },
          "effective_until": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle_state": {
            "enum": [
              "repealed",
              "suspended_gap"
            ]
          }
        },
        "required": [
          "lifecycle_state"
        ]
      },
      "then": {
        "required": [
          "gap_or_repeal_reason"
        ],
        "properties": {
          "gap_or_repeal_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication_state": {
            "const": "PUBLISHED_WITH_CAVEAT"
          }
        },
        "required": [
          "publication_state"
        ]
      },
      "then": {
        "properties": {
          "caveat_codes": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": [
          "caveat_codes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "publication_state": {
            "const": "VERIFIED_PUBLISHABLE"
          }
        },
        "required": [
          "publication_state"
        ]
      },
      "then": {
        "required": [
          "human_verification_status",
          "reviewer_id",
          "reviewed_at_utc"
        ],
        "properties": {
          "human_verification_status": {
            "const": "extraction_verified"
          },
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at_utc": {
            "type": "string",
            "format": "date-time"
          },
          "cmap_corruption_detected": {
            "const": false
          },
          "caveat_codes": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication_state": {
            "const": "UNRESOLVED_HISTORICAL"
          }
        },
        "required": [
          "publication_state"
        ]
      },
      "then": {
        "required": [
          "uncertainty_window_start",
          "uncertainty_window_end"
        ],
        "properties": {
          "uncertainty_window_start": {
            "type": "string",
            "format": "date"
          },
          "uncertainty_window_end": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  ]
}
