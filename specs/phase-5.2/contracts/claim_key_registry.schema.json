{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lexagent.local/schemas/phase-5.2/claim_key_registry.schema.json",
  "title": "ClaimKeyRegistry (Fail-Closed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logical_provision_id",
          "applicable_version_ids",
          "claim_key",
          "review_status",
          "reviewer_id",
          "reviewed_at_utc",
          "rationale"
        ],
        "properties": {
          "logical_provision_id": {
            "type": "string",
            "minLength": 1
          },
          "applicable_version_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_key": {
            "type": "string",
            "minLength": 1
          },
          "subject_obligation": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "employer",
              "worker",
              null
            ],
            "default": null
          },
          "review_status": {
            "type": "string",
            "enum": [
              "approved",
              "draft",
              "deprecated"
            ]
          },
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at_utc": {
            "type": "string",
            "format": "date-time"
          },
          "rationale": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  }
}
